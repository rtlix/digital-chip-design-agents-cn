{
  "_comment": "Bambu HLS 批处理 MCP Server —— 将 mcpServers 配置块粘贴到 .claude/settings.json。请把 /absolute/path/to 替换为本仓库的实际绝对路径。",
  "mcpServers": {
    "bambu": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "/absolute/path/to/plugins/infrastructure/tools/mcp-adapter.py",
        "--wrapper", "/absolute/path/to/plugins/infrastructure/tools/wrap-bambu.sh",
        "--tool", "bambu",
        "--description", "运行 Bambu HLS 综合并返回紧凑 JSON：latency_cycles、dsp_count、bram_count、error/warning 数量"
      ],
      "env": {
        "BAMBU_HOME": "/path/to/bambu",
        "HLS_TARGET_DEVICE": "<set_to_target_device_part_number>",
        "TOOL_TIMEOUT_S": "600"
      }
    }
  }
}
